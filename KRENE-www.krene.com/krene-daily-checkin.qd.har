[
  {
    "comment": "1. 获取活动列表（公开接口）：提取每日签到活动的 activityId",
    "request": {
      "method": "GET",
      "url": "https://www.krene.com/krene-backend-ts/api/member/activities",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "K-Authorization",
          "value": "{{Authorization}}"
        },
        {
          "name": "krene_user",
          "value": "{{krene_user}}"
        },
        {
          "name": "X-Language",
          "value": "zh-CN"
        },
        {
          "name": "Origin",
          "value": "https://www.krene.com"
        },
        {
          "name": "Referer",
          "value": "https://www.krene.com/design/dashboard/home"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"success\":true",
          "from": "content"
        },
        {
          "re": "10000001",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"code\":500",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "dailyActivityId",
          "re": "\"activityId\":\"(\\d+)\",\"name\":\"每日登录领水滴\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "2. 签到前查询会员信息：记录签到前水滴余额、注册天数、今日签到状态",
    "request": {
      "method": "GET",
      "url": "https://www.krene.com/krene-backend-ts/api/member/info",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "K-Authorization",
          "value": "{{Authorization}}"
        },
        {
          "name": "krene_user",
          "value": "{{krene_user}}"
        },
        {
          "name": "X-Language",
          "value": "zh-CN"
        },
        {
          "name": "Origin",
          "value": "https://www.krene.com"
        },
        {
          "name": "Referer",
          "value": "https://www.krene.com/design/dashboard/home"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"success\":true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Unauthorized",
          "from": "content"
        },
        {
          "re": "\"code\":401",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "waterBefore",
          "re": "\"flowingWater\":(\\d+)",
          "from": "content"
        },
        {
          "name": "registerDays",
          "re": "\"registerDays\":(\\d+)",
          "from": "content"
        },
        {
          "name": "dailyStatus",
          "re": "\"activityId\":\"10000001\".*?\"status\":\"(\\w+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "3. 每日签到领水滴（每天 50 水滴；今日已领取也算成功）",
    "request": {
      "method": "POST",
      "url": "https://www.krene.com/krene-backend-ts/api/member/claim-daily-reward",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "K-Authorization",
          "value": "{{Authorization}}"
        },
        {
          "name": "krene_user",
          "value": "{{krene_user}}"
        },
        {
          "name": "X-Language",
          "value": "zh-CN"
        },
        {
          "name": "Origin",
          "value": "https://www.krene.com"
        },
        {
          "name": "Referer",
          "value": "https://www.krene.com/design/dashboard/home"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"
        }
      ],
      "cookies": [],
      "mimeType": "application/json",
      "data": "{\"activityId\":\"{{ dailyActivityId|default(\"10000001\") }}\"}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"success\":true",
          "from": "content"
        },
        {
          "re": "今日已领取",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Unauthorized",
          "from": "content"
        },
        {
          "re": "\"code\":401",
          "from": "content"
        },
        {
          "re": "缺少必填参数",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "rewardAmount",
          "re": "\"rewardAmount\":(\\d+)",
          "from": "content"
        },
        {
          "name": "claimMessage",
          "re": "\"message\":\"([^\"]*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "4. 签到后再次查询会员信息：记录签到后水滴余额，用于计算变化",
    "request": {
      "method": "GET",
      "url": "https://www.krene.com/krene-backend-ts/api/member/info",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "K-Authorization",
          "value": "{{Authorization}}"
        },
        {
          "name": "krene_user",
          "value": "{{krene_user}}"
        },
        {
          "name": "X-Language",
          "value": "zh-CN"
        },
        {
          "name": "Origin",
          "value": "https://www.krene.com"
        },
        {
          "name": "Referer",
          "value": "https://www.krene.com/design/dashboard/home"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36 Edg/156.0.0.0"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"success\":true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Unauthorized",
          "from": "content"
        },
        {
          "re": "\"code\":401",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "waterAfter",
          "re": "\"flowingWater\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "5. 拼装签到回报文案（写入 __log__，qd 任务日志会显示水滴变化）",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&p=%C2%A0&t=%C2%A0&s={% set wb = waterBefore|default(\"0\")|int %}{% set wa = waterAfter|default(\"0\")|int %}{% set d = wa - wb %}{% set delta = (\"+\" ~ d) if d > 0 else (\"无变化\" if d == 0 else (d|string)) %}{% set line = \"Krene 每日签到：\" ~ (claimMessage|default(\"签到成功\")) ~ \"\\n账号：\" ~ krene_user ~ \"\\n水滴：\" ~ (wb|string) ~ \" → \" ~ (wa|string) ~ \"（\" ~ delta ~ \"）\" ~ \"\\n注册天数：\" ~ (registerDays|default(\"?\")) ~ \" 天\" %}{{ line|urlencode }}",
      "headers": [],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "[\\s\\S]+",
          "from": "content"
        }
      ]
    }
  }
]
