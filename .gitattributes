# 让 Git 自动识别文本文件
* text=auto

# 源码与文档：统一 LF（跨平台友好）
*.py   text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不处理
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.har  binary
*.7z   binary